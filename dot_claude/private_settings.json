{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "2000000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(rtk read *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr checkout *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh run list *)",
      "Bash(rtk gh run view *)",
      "Bash(fly checks *)",
      "Bash(fly logs *)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/zsh/.zshenv)",
      "Read(~/.config/zsh/.zshenv.local)"
    ],
    "ask": [
      "Bash(brew *)",
      "Bash(mise *)",
      "Bash(fly apps*)",
      "Bash(fly deploy*)",
      "Bash(fly launch*)",
      "Bash(fly machine*)",
      "Bash(fly console*)",
      "Bash(fly sftp*)",
      "Bash(fly ssh*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_TMPDIR/discuss-$CLAUDE_CODE_SESSION_ID.lock\" || { echo 'Discussion mode is active — file edits are blocked. Run /discuss end to exit.'; exit 2; }"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pnpm dlx ccstatusline@latest"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "autoMemoryEnabled": false,
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "localhost",
        "127.0.0.1"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/node",
        "~/.local/share/pnpm",
        "~/.cache/pnpm"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "git *",
      "rtk git *",
      "gh *",
      "rtk gh *",
      "aws *",
      "fly *",
      "heroku *",
      "terraform *",
      "codex *"
    ]
  },
  "showClearContextOnPlanAccept": true,
  "plansDirectory": "./.claude/plans",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
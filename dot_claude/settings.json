{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_AFK_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr checkout *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh run list *)",
      "Bash(rtk gh run view *)",
      "Bash(fly checks *)",
      "Bash(fly logs *)",
      "Bash(crit comment *)",
      "Bash(crit plan *)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git reset *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/zsh/.zshenv)",
      "Read(~/.config/zsh/.zshenv.local)"
    ],
    "ask": [
      "Bash(brew *)",
      "Bash(mise *)",
      "Bash(fly apps*)",
      "Bash(fly deploy*)",
      "Bash(fly launch*)",
      "Bash(fly machine*)",
      "Bash(fly console*)",
      "Bash(fly sftp*)",
      "Bash(fly ssh*)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(rtk brew *)",
      "Bash(rtk git push *)",
      "Bash(rtk gh issue create *)",
      "Bash(rtk gh pr create *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pnpm dlx ccstatusline@latest"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "codex@openai-codex": true,
    "crit@crit": true,
    "discuss@pb-cc-plugins": true,
    "orchestrate@pb-cc-plugins": true,
    "session-residue@pb-cc-plugins": true,
    "ponytail@ponytail": true,
    "egm@egm": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "pb-cc-plugins": {
      "source": {
        "source": "github",
        "repo": "mahito1594/pb-cc-plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "mise.jdx.dev",
        "registry.npmjs.org",
        "index.rubygems.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/node",
        "~/.local/share/pnpm",
        "~/.cache/pnpm",
        "/private/tmp/pnpm-store-operation-locks-501",
        "~/.cache/bundle",
        "~/.local/share/mise/installs/ruby",
        "~/.crit",
        "~/notes"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker *",
      "rtk docker *",
      "git *",
      "rtk git *",
      "gh *",
      "rtk gh *",
      "aws *",
      "rtk aws *",
      "fly *",
      "heroku *",
      "terraform *",
      "rtk terraform *",
      "codex *",
      "crit *",
      "pnpm dev *"
    ]
  },
  "showClearContextOnPlanAccept": true,
  "plansDirectory": "./.claude/plans",
  "timeFormat": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
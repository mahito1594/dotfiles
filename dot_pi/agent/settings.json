{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.0",
  "theme": "dark",
  "defaultProvider": "synthetic",
  "defaultModel": "syn:large:text",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-sandbox",
    "git:github.com/DietrichGebert/ponytail",
    {
      "source": "npm:@aliou/pi-synthetic",
      "extensions": [
        "+extensions/provider/index.ts",
        "+extensions/web-search/index.ts",
        "+extensions/command-quotas/index.ts",
        "-extensions/usage-status/index.ts",
        "-extensions/quota-warnings/index.ts"
      ]
    },
    {
      "source": "npm:pi-subagents",
      "prompts": []
    }
  ],
  "subagents": {
    "agentOverrides": {
      "researcher": {
        "disabled": true
      },
      "evidence-auditor": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true
}
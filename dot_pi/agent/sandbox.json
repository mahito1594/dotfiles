{
  "enabled": true,
  "enableAccessRequestTool": true,
  "sandboxUserShell": false,
  "network": {
    "allowLocalBinding": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowSSHAgentSocket": true,
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "mise.jdx.dev",
      "registry.npmjs.org",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "crates.io",
      "*.crates.io",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org",
      "rubygems.org",
      "*.rubygems.org"
    ]
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      "~/.local",
      "~/Library",
      "~/.agents/skills",
      "~/.pi/agent/skills",
      "~/.pi/agent/npm",
      "~/.pi/agent/git",
      "~/.pi/agent/extensions",
      "~/.config/mise",
      "~/.config/git",
      "~/.config/gh",
      "~/.config/cargo"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "~/.crit",
      "~/notes",
      "~/.cache/mise",
      "~/.npm",
      "~/.cache/node",
      "~/.local/share/pnpm",
      "~/.cache/pnpm",
      "~/.config/cargo/registry",
      "~/.config/cargo/git",
      "~/.config/cargo/.package-cache",
      "~/.cache/uv",
      "~/.cache/gem",
      "~/.cache/bundle",
      "~/.cache/rubocop_cache"
    ],
    "denyWrite": [
      ".env",
      "**/.env",
      ".env.*",
      "**/.env.*",
      "*.pem",
      "**/*.pem",
      "*.key",
      "**/*.key"
    ]
  }
}
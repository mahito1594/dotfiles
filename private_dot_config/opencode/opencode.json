{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push *": "deny",
      "get reset *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "rm -rf *": "deny",
      "wc *": "allow"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}